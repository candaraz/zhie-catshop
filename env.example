# Konfigurasi Supabase untuk Zhie Catshop
# Salin file ini menjadi .env lalu isi dengan kredensial proyek Supabase Anda.
# PENTING: Hanya gunakan ANON (public) key di frontend. JANGAN PERNAH menaruh SERVICE_ROLE secret key di sini.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
